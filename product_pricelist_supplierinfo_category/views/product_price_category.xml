<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="product_price_category_form_" model="ir.ui.view">
        <field name="model">product.price.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <group name="left">
                            <field name="name"/>
                        </group>
                        <group name="right">
                            <field name="supplierinfo_margin"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_price_category_list_" model="ir.ui.view">
        <field name="model">product.price.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="supplierinfo_margin"/>
                <field name="field3" optional="show" />
                <field name="company_id" groups="base.group_multi_company" optional="show" readonly="1" />
            </list>
        </field>
    </record>

    <record id="product_price_category_search_" model="ir.ui.view">
        <field name="model">product.price.category</field>
        <field name="arch" type="xml">
            <search>
                <filter name="name"/>
                <filter name="supplierinfo_margin"/>
            </search>
        </field>
    </record>

    <record id="product_price_category_action" model="ir.actions.act_window">
        <field name="name">product_price_category_action</field>
        <field name="res_model">product.price.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="product_price_category_menu_"
        parent="base.menu_administration"
        action="product_price_category_action"/>

    <!--     purchase.menu_purchase_config
        purchase.menu_purchase_root
        stock.menu_stock_config_settings
     -->

</odoo>
