<odoo>

    <record id="report_invoice_document" model="ir.ui.view">
        <field name="inherit_id" ref="account.report_invoice_document" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='customer_code']" position="attributes">
                <attribute name="style">visibility: hidden;</attribute>
            </xpath>
            <xpath expr="//div[@name='customer_code']" position="after">
                <div class="col" t-if="o.preferred_payment_method_line_id" name="payment_mode">
                    <strong>Mode de paiement</strong>
                    <div t-field="o.preferred_payment_method_line_id.name"/>
                </div>
            </xpath>
            <xpath expr="//p[@name='payment_communication']" position="attributes">
                <attribute name="t-if">o.display_communication</attribute>
            </xpath>
        </field>
    </record>

</odoo>
