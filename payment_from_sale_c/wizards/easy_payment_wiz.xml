<odoo>

    <record id="easy_payment_wiz_form" model="ir.ui.view">
        <field name="model">easy.payment.wiz</field>
        <field name="arch" type="xml">
            <form>
                <group name="main">
                    <group>
                        <field name="payment_method_line_id" widget="radio" domain="payment_domain"/>
                        <field name="payment_domain" invisible="1" />
                        <field name="amount" />
                        <field name="company_id" invisible="1" />
                    </group>
                    <group>
                        <field name="communication" />
                        <field name="payment_date" />
                    </group>
                </group>
                <footer>
                    <button string="Payer" type="object" name="invoice_and_pay"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="easy_payment_wiz_action" model="ir.actions.act_window">
        <field name="name">Easy payment</field>
        <field name="res_model">easy.payment.wiz</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{"easy_payment": "1"}</field>
    </record>

</odoo>
